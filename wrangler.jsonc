{
  "name": "silua-axis",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/admin/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "silua-axis",
    "GITHUB_BRANCH": "main",
    "GITHUB_REPOS": "silua-aideabank,silua-axis",
    "ADMIN_ENABLED": "false",
    "ADMIN_URL": "https://silua-aideabank.progen-web.workers.dev/admin"
  }
}
